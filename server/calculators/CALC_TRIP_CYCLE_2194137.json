{
  "name": "Calc_Trip_Cycle - [Zone Name] - [Operation Name] - LIQ",
  "intervals_ttl": 31536000,
  "update_delay": 30,
  "update_period": 864000,
  "update_onchange": true,
  "timezone": "America/Lima",
  "selectors": [
    {
      "expression": "geofence() == '[Zone Geofence Name]'"
    }
  ],
  "counters": [
    {
      "name": "device_id",
      "type": "parameter",
      "parameter": "device.id"
    },
    {
      "name": "cycle_duration",
      "type": "duration"
    },
    {
      "name": "cycle_duration_formated",
      "type": "duration",
      "format": "%H:%M:%S"
    },
    {
      "name": "load_cycle",
      "type": "calc",
      "calc_id": "[Calc_Load_Pad ID]",
      "counter": "load_pad_duration",
      "method": "sum"
    },
    {
      "name": "haul_cycle",
      "type": "calc",
      "calc_id": "[Calc_Trip_L2D ID]",
      "counter": "trip_duration",
      "method": "sum"
    },
    {
      "name": "dump_cycle",
      "type": "calc",
      "calc_id": "[Calc_Dump_Area ID]",
      "counter": "dump_duration",
      "method": "sum"
    },
    {
      "name": "return_cycle",
      "type": "calc",
      "calc_id": "[Calc_Trip_D2L ID]",
      "counter": "return_duration",
      "method": "sum"
    },
    {
      "name": "queue_cycle",
      "type": "calc",
      "calc_id": "[Calc_Queue_Area ID]",
      "counter": "queue_duration",
      "method": "sum"
    },
    {
      "name": "total_distance_km",
      "type": "expression",
      "expression": "mileage / 1000"
    },
    {
      "name": "mileage",
      "type": "mileage"
    },
    {
      "name": "trips_count",
      "type": "calc",
      "calc_id": "[Calc_Trip_L2D ID]",
      "counter": "device_id",
      "method": "count"
    },
    {
      "name": "material_moved_m3",
      "type": "calc",
      "calc_id": "[Calc_Dump_Area ID]",
      "counter": "material_dumped_m3",
      "method": "sum"
    }
  ]
}
