{
  "name": "Calc_Trip_Cycle - [Zone Name] - [Operation Name] - LIQ",
  "intervals_ttl": 31536000,
  "update_delay": 30,
  "update_period": 864000,
  "update_onchange": true,
  "timezone": "America/Lima",
  "selectors": [
    {
      "expression": "geofence() == '[Zone Geofence Name]'"
    }
  ],
  "counters": [
    {
      "name": "device_id",
      "type": "parameter",
      "parameter": "device.id",
      "method": "last"
    },
    {
      "name": "cycle_duration",
      "type": "interval",
      "expression": "duration"
    },
    {
      "name": "cycle_duration_formated",
      "type": "interval",
      "expression": "if(duration >= 3600, tostring(floor(duration/3600)) + 'h ' + tostring(floor((duration%3600)/60)) + 'm ' + tostring(floor(duration%60)) + 's', tostring(floor(duration/60)) + 'm ' + tostring(floor(duration%60)) + 's')"
    },
    {
      "name": "load_cycle",
      "type": "calc",
      "calc_id": 0,
      "counter": "load_pad_duration",
      "method": "sum"
    },
    {
      "name": "haul_cycle",
      "type": "calc",
      "calc_id": 0,
      "counter": "trip_duration",
      "method": "sum"
    },
    {
      "name": "dump_cycle",
      "type": "calc",
      "calc_id": 0,
      "counter": "dump_duration",
      "method": "sum"
    },
    {
      "name": "return_cycle",
      "type": "calc",
      "calc_id": 0,
      "counter": "return_duration",
      "method": "sum"
    },
    {
      "name": "queue_cycle",
      "type": "calc",
      "calc_id": 0,
      "counter": "queue_duration",
      "method": "sum"
    },
    {
      "name": "total_distance_km",
      "type": "expression",
      "expression": "mileage / 1000"
    },
    {
      "name": "mileage",
      "type": "expression",
      "method": "last",
      "expression": "mileage"
    },
    {
      "name": "trips_count",
      "type": "calc",
      "calc_id": 0,
      "counter": "device_id",
      "method": "count"
    },
    {
      "name": "material_moved_m3",
      "type": "calc",
      "calc_id": 0,
      "counter": "material_dumped_m3",
      "method": "sum"
    }
  ]
}

