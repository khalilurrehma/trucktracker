{
  "name": "OP_Calculator - [Operation Name] - LIQ",
  "intervals_ttl": 31536000,
  "update_delay": 30,
  "update_period": 864000,
  "update_onchange": true,
  "timezone": "America/Lima",
  "selectors": [
    {
      "expression": "geofence() == '[Operation Geofence Name]'"
    }
  ],
  "counters": [
    {
      "name": "device_id",
      "type": "parameter",
      "parameter": "device.id"
    },
    {
      "name": "active",
      "type": "active"
    },
    {
      "name": "operation_duration",
      "type": "duration"
    },
    {
      "name": "total_material_m3",
      "type": "calc",
      "calc_id": "[Zone_Calculator ID]",
      "counter": "zone_material_m3",
      "method": "sum"
    },
    {
      "name": "total_trips",
      "type": "calc",
      "calc_id": "[Zone_Calculator ID]",
      "counter": "zone_trips",
      "method": "sum"
    },
    {
      "name": "avg_cycle_time",
      "type": "calc",
      "calc_id": "[Zone_Calculator ID]",
      "counter": "zone_avg_cycle",
      "method": "avg"
    },
    {
      "name": "avg_queue_time",
      "type": "calc",
      "calc_id": "[Zone_Calculator ID]",
      "counter": "zone_avg_queue",
      "method": "avg"
    },
    {
      "name": "active_vehicles",
      "type": "calc",
      "calc_id": "[Zone_Calculator ID]",
      "counter": "active_vehicles",
      "method": "sum"
    },
    {
      "name": "active_loaders",
      "type": "calc",
      "calc_id": "[Zone_Calculator ID]",
      "counter": "active_loaders",
      "method": "sum"
    },
    {
      "name": "productivity_m3_h",
      "type": "expression",
      "expression": "operation_duration > 0 ? (total_material_m3 / (operation_duration / 3600)) : 0"
    }
  ]
}
