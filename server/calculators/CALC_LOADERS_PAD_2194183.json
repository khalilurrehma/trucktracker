{
  "name": "Calc_Loaders_Pad - [Zone Name] - [Operation Name] - LIQ",
  "intervals_ttl": 31536000,
  "update_delay": 30,
  "update_period": 864000,
  "update_onchange": true,
  "timezone": "America/Lima",
  "selectors": [
    {
      "type": "expression",
      "expression": "geofence(\"metadata.zone_type\") == \"LOAD_PAD\""
    }
  ],
  "counters": [
    {
      "name": "device_id",
      "type": "parameter",
      "parameter": "device.id",
      "method": "last"
    },
    {
      "name": "active",
      "type": "active"
    },
    {
      "name": "loader_duration",
      "type": "interval",
      "expression": "duration"
    },
    {
      "name": "truck_device_id",
      "type": "parameter",
      "parameter": "truck_device_id",
      "method": "last"
    },
    {
      "name": "truck_capacity_m3",
      "type": "parameter",
      "parameter": "truck_capacity_m3",
      "method": "last"
    },
    {
      "name": "truck_fill_factor_ideal",
      "type": "parameter",
      "parameter": "truck_fill_factor_ideal",
      "method": "last"
    },
    {
      "name": "truck_present",
      "type": "parameter",
      "parameter": "truck_present",
      "method": "last"
    },
    {
      "name": "enriched",
      "type": "parameter",
      "parameter": "enriched",
      "method": "last"
    },
    {
      "name": "loader_bucket_capacity_m3",
      "type": "parameter",
      "parameter": "device.metadata.loader_bucket_capacity_m3",
      "method": "last"
    },
    {
      "name": "loader_bucket_fill_factor_ideal",
      "type": "parameter",
      "parameter": "device.metadata.loader_bucket_fill_factor_ideal",
      "method": "last"
    },
    {
      "name": "trips_to_fill_ideal",
      "type": "expression",
      "method": "last",
      "expression": "ceil((truck_capacity_m3 * truck_fill_factor_ideal) / (device.metadata.loader_bucket_capacity_m3 * device.metadata.loader_bucket_fill_factor_ideal))"
    },
    {
      "name": "idle_time",
      "type": "expression",
      "method": "last",
      "expression": "if(truck_present == false, duration, 0)"
    }
  ]
}
