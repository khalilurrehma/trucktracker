{
  "name": "Calc_Load_Pad - [Zone Name] - [Operation Name] - LIQ",
  "intervals_ttl": 31536000,
  "update_delay": 30,
  "update_period": 864000,
  "update_onchange": true,
  "timezone": "America/Lima",
  "selectors": [
    {
      "expression": "geofence() == '[LoadPad Geofence Name]'"
    }
  ],
  "counters": [
    {
      "name": "device_id",
      "type": "parameter",
      "parameter": "device.id"
    },
    {
      "name": "active",
      "type": "active"
    },
    {
      "name": "load_pad_duration",
      "type": "duration"
    },
    {
      "name": "load_pad_duration_formated",
      "type": "duration",
      "format": "%H:%M:%S"
    },
    {
      "name": "position_lat",
      "type": "last",
      "parameter": "position.latitude"
    },
    {
      "name": "position_lon",
      "type": "last",
      "parameter": "position.longitude"
    },
    {
      "name": "speed_max",
      "type": "max",
      "parameter": "position.speed"
    },
    {
      "name": "speed_avg",
      "type": "avg",
      "parameter": "position.speed"
    }
  ]
}
