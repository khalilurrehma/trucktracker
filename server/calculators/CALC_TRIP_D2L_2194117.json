{
  "name": "Calc_Trip_D2L - [Zone Name] - [Operation Name] - LIQ",
  "intervals_ttl": 31536000,
  "update_delay": 30,
  "update_period": 864000,
  "update_onchange": true,
  "timezone": "America/Lima",
  "selectors": [
    {
      "type": "geofences_transit",
      "from": "[DumpArea Flespi Geofence ID]",
      "to": "[LoadPad Flespi Geofence ID]"
    }
  ],
  "counters": [
    {
      "name": "device_id",
      "type": "parameter",
      "parameter": "device.id"
    },
    {
      "name": "return_duration",
      "type": "duration"
    },
    {
      "name": "return_duration_formated",
      "type": "duration",
      "format": "%H:%M:%S"
    },
    {
      "name": "return_distance_km",
      "type": "expression",
      "expression": "mileage / 1000"
    },
    {
      "name": "mileage",
      "type": "mileage"
    },
    {
      "name": "speed_max",
      "type": "max",
      "parameter": "position.speed"
    },
    {
      "name": "speed_avg",
      "type": "avg",
      "parameter": "position.speed"
    }
  ]
}
