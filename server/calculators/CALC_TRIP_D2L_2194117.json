{
  "name": "Calc_Trip_D2L - [Zone Name] - [Operation Name] - LIQ",
  "intervals_ttl": 31536000,
  "update_delay": 30,
  "update_period": 864000,
  "update_onchange": true,
  "timezone": "America/Lima",
  "validate_interval": "from_zone_type == \"DUMP_AREA\" && to_zone_type == \"LOAD_PAD\"",
  "selectors": [
    {
      "type": "expression",
      "method": "boolean",
      "expression": "geofence() == null",
      "merge_unknown": true,
      "merge_message_before": true,
      "merge_message_after": true,
      "max_messages_time_diff": 300,
      "max_inactive": 120,
      "min_duration": 60
    }
  ],
  "counters": [
    {
      "name": "from_zone_type",
      "type": "expression",
      "method": "first",
      "expression": "geofence(\"metadata.zone_type\")"
    },
    {
      "name": "to_zone_type",
      "type": "expression",
      "method": "last",
      "expression": "geofence(\"metadata.zone_type\")"
    },
    {
      "name": "device_id",
      "type": "parameter",
      "parameter": "device.id",
      "method": "last"
    },
    {
      "name": "return_duration",
      "type": "interval",
      "expression": "duration"
    },
    {
      "name": "return_duration_formated",
      "type": "interval",
      "expression": "if(duration >= 3600, tostring(floor(duration/3600)) + 'h ' + tostring(floor((duration%3600)/60)) + 'm ' + tostring(floor(duration%60)) + 's', tostring(floor(duration/60)) + 'm ' + tostring(floor(duration%60)) + 's')"
    },
    {
      "name": "return_distance_km",
      "type": "expression",
      "method": "last",
      "expression": "mileage / 1000"
    },
    {
      "name": "mileage",
      "type": "parameter",
      "parameter": "mileage",
      "method": "last"
    },
    {
      "name": "speed_max",
      "type": "expression",
      "method": "maximum",
      "expression": "position.speed"
    },
    {
      "name": "speed_avg",
      "type": "expression",
      "method": "average",
      "expression": "position.speed"
    }
  ]
}
