{
  "name": "Operation_Summary - [Operation Name] - LIQ",
  "intervals_ttl": 31536000,
  "update_delay": 30,
  "update_period": 864000,
  "update_onchange": true,
  "timezone": "America/Lima",
  "validate_interval": "day",
  "selectors": [
    {
      "type": "expression",
      "expression": "geofence() == '[Operation Geofence Name]'"
    }
  ],
  "counters": [
    {
      "name": "device_id",
      "type": "parameter",
      "parameter": "device.id",
      "method": "last"
    },
    {
      "name": "summary_date",
      "type": "parameter",
      "parameter": "timestamp",
      "method": "first"
    },
    {
      "name": "total_material_moved_m3",
      "type": "calc",
      "calc_id": 0,
      "counter": "total_material_m3",
      "method": "last"
    },
    {
      "name": "total_trips_count",
      "type": "calc",
      "calc_id": 0,
      "counter": "total_trips",
      "method": "last"
    },
    {
      "name": "efficiency_pct",
      "type": "expression",
      "method": "last",
      "expression": "if(target_material_m3 > 0, ((total_material_moved_m3 / target_material_m3) * 100), 0)"
    },
    {
      "name": "target_material_m3",
      "type": "expression",
      "method": "last",
      "expression": "device.metadata.operation_target_m3"
    }
  ]
}
