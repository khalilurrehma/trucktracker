{
  "name": "Calc_Dump_Area - [Zone Name] - [Operation Name] - LIQ",
  "intervals_ttl": 31536000,
  "update_delay": 30,
  "update_period": 864000,
  "update_onchange": true,
  "timezone": "America/Lima",
  "selectors": [
    {
      "expression": "geofence() == '[DumpArea Geofence Name]'"
    }
  ],
  "counters": [
    {
      "name": "device_id",
      "type": "parameter",
      "parameter": "device.id"
    },
    {
      "name": "active",
      "type": "active"
    },
    {
      "name": "dump_duration",
      "type": "duration"
    },
    {
      "name": "dump_duration_formated",
      "type": "duration",
      "format": "%H:%M:%S"
    },
    {
      "name": "position_lat",
      "type": "last",
      "parameter": "position.latitude"
    },
    {
      "name": "position_lon",
      "type": "last",
      "parameter": "position.longitude"
    },
    {
      "name": "material_dumped_m3",
      "type": "expression",
      "expression": "device.metadata.vehicle_capacity_m3 * device.metadata.vehicle_fill_factor_ideal"
    }
  ]
}
