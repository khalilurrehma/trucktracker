{
  "name": "Calc_Dump_Area - [Zone Name] - [Operation Name] - LIQ",
  "intervals_ttl": 31536000,
  "update_delay": 30,
  "update_period": 864000,
  "update_onchange": true,
  "timezone": "America/Lima",
  "selectors": [
    {
      "type": "expression",
      "expression": "json_array_contains(geofences(\"metadata.zone_type\"), \"DUMP_AREA\")"
    }
  ],
  "counters": [
    {
      "name": "device_id",
      "type": "parameter",
      "parameter": "device.id",
      "method": "last"
    },
    {
      "name": "active",
      "type": "active"
    },
    {
      "name": "dump_duration",
      "type": "interval",
      "expression": "duration"
    },
    {
      "name": "dump_duration_formated",
      "type": "interval",
      "expression": "if(duration >= 3600, tostring(floor(duration/3600)) + 'h ' + tostring(floor((duration%3600)/60)) + 'm ' + tostring(floor(duration%60)) + 's', tostring(floor(duration/60)) + 'm ' + tostring(floor(duration%60)) + 's')"
    },
    {
      "name": "position_lat",
      "type": "parameter",
      "parameter": "position.latitude",
      "method": "last"
    },
    {
      "name": "position_lon",
      "type": "parameter",
      "parameter": "position.longitude",
      "method": "last"
    },
    {
      "name": "material_dumped_m3",
      "type": "expression",
      "method": "last",
      "expression": "metadata(\"vehicle_capacity_m3\") * metadata(\"vehicle_fill_factor_ideal\")"
    }
  ]
}

