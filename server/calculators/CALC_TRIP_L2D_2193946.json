{
  "name": "Calc_Trip_L2D - [Zone Name] - [Operation Name] - LIQ",
  "intervals_ttl": 31536000,
  "update_delay": 30,
  "update_period": 864000,
  "update_onchange": true,
  "timezone": "America/Lima",
  "selectors": [
    {
      "type": "geofences_transit",
      "from": "[LoadPad Flespi Geofence ID]",
      "to": "[DumpArea Flespi Geofence ID]"
    }
  ],
  "counters": [
    {
      "name": "device_id",
      "type": "parameter",
      "parameter": "device.id"
    },
    {
      "name": "trip_duration",
      "type": "duration"
    },
    {
      "name": "trip_duration_formated",
      "type": "duration",
      "format": "%H:%M:%S"
    },
    {
      "name": "trip_distance_km",
      "type": "expression",
      "expression": "mileage / 1000"
    },
    {
      "name": "mileage",
      "type": "mileage"
    },
    {
      "name": "speed_max",
      "type": "max",
      "parameter": "position.speed"
    },
    {
      "name": "speed_avg",
      "type": "avg",
      "parameter": "position.speed"
    },
    {
      "name": "material_m3",
      "type": "expression",
      "expression": "device.metadata.vehicle_capacity_m3 * device.metadata.vehicle_fill_factor_ideal"
    },
    {
      "name": "vehicle_capacity_m3",
      "type": "parameter",
      "parameter": "device.metadata.vehicle_capacity_m3"
    },
    {
      "name": "vehicle_fill_factor_ideal",
      "type": "parameter",
      "parameter": "device.metadata.vehicle_fill_factor_ideal"
    }
  ]
}
