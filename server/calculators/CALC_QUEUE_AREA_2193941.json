{
  "name": "Calc_Queue_Area - [Zone Name] - [Operation Name] - LIQ",
  "intervals_ttl": 31536000,
  "update_delay": 30,
  "update_period": 864000,
  "update_onchange": true,
  "timezone": "America/Lima",
  "selectors": [
    {
      "expression": "geofence() == '[QueueArea Geofence Name]'"
    }
  ],
  "counters": [
    {
      "name": "device_id",
      "type": "parameter",
      "parameter": "device.id"
    },
    {
      "name": "active",
      "type": "active"
    },
    {
      "name": "queue_duration",
      "type": "duration"
    },
    {
      "name": "queue_duration_formated",
      "type": "duration",
      "format": "%H:%M:%S"
    },
    {
      "name": "position_lat",
      "type": "last",
      "parameter": "position.latitude"
    },
    {
      "name": "position_lon",
      "type": "last",
      "parameter": "position.longitude"
    },
    {
      "name": "queue_position",
      "type": "count"
    }
  ]
}
