{
  "name": "Calc_Queue_Area - [Zone Name] - [Operation Name] - LIQ",
  "intervals_ttl": 31536000,
  "update_delay": 30,
  "update_period": 864000,
  "update_onchange": true,
  "timezone": "America/Lima",
  "selectors": [
    {
      "type": "expression",
      "expression": "geofence(\"metadata.zone_type\") == \"QUEUE_AREA\""
    }
  ],
  "counters": [
    {
      "name": "device_id",
      "type": "parameter",
      "parameter": "device.id",
      "method": "last"
    },
    {
      "name": "active",
      "type": "active"
    },
    {
      "name": "queue_duration",
      "type": "interval",
      "expression": "duration"
    },
    {
      "name": "queue_duration_formated",
      "type": "interval",
      "expression": "if(duration >= 3600, tostring(floor(duration/3600)) + 'h ' + tostring(floor((duration%3600)/60)) + 'm ' + tostring(floor(duration%60)) + 's', tostring(floor(duration/60)) + 'm ' + tostring(floor(duration%60)) + 's')"
    },
    {
      "name": "position_lat",
      "type": "parameter",
      "parameter": "position.latitude",
      "method": "last"
    },
    {
      "name": "position_lon",
      "type": "parameter",
      "parameter": "position.longitude",
      "method": "last"
    },
    {
      "name": "queue_position",
      "type": "expression",
      "method": "summary",
      "expression": "1"
    }
  ]
}
