{
  "name": "Zone_Calculator - [Zone Name] - [Operation Name] - LIQ",
  "intervals_ttl": 31536000,
  "update_delay": 30,
  "update_period": 864000,
  "update_onchange": true,
  "timezone": "America/Lima",
  "selectors": [
    {
      "expression": "geofence() == '[Zone Geofence Name]'"
    }
  ],
  "counters": [
    {
      "name": "device_id",
      "type": "parameter",
      "parameter": "device.id",
      "method": "last"
    },
    {
      "name": "active",
      "type": "active"
    },
    {
      "name": "zone_duration",
      "type": "interval",
      "expression": "duration"
    },
    {
      "name": "zone_material_m3",
      "type": "calc",
      "calc_id": 0,
      "counter": "material_dumped_m3",
      "method": "sum"
    },
    {
      "name": "zone_trips",
      "type": "calc",
      "calc_id": 0,
      "counter": "device_id",
      "method": "count"
    },
    {
      "name": "zone_avg_cycle",
      "type": "calc",
      "calc_id": 0,
      "counter": "cycle_duration",
      "method": "avg"
    },
    {
      "name": "zone_avg_queue",
      "type": "calc",
      "calc_id": 0,
      "counter": "queue_duration",
      "method": "avg"
    },
    {
      "name": "active_vehicles",
      "type": "calc",
      "calc_id": 0,
      "counter": "active",
      "method": "sum"
    },
    {
      "name": "active_loaders",
      "type": "calc",
      "calc_id": 0,
      "counter": "active",
      "method": "sum"
    }
  ]
}

